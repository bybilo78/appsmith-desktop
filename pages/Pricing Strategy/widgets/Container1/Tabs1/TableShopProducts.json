      "computedValue": "{{(() => { const tableData = TableShopProducts.processedTableData || []; return tableData.length > 0 ? tableData.map((currentRow, currentIndex) => (\n  (() => {\n    const value = Math.min(100, Math.max(0, Number(currentRow.margin_percent) || 0));\n    const minimum = 30;\n\n    return `\n      <div style=\"\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        width: 100%;\n      \">\n        <div style=\"\n          position: relative;\n          width: 120px;\n          height: 18px;\n          background: #e5e7eb;\n          border-radius: 9px;\n          overflow: hidden;\n        \">\n          <div style=\"\n            width: ${value}%;\n            height: 100%;\n            background: #7a9b76;\n            border-radius: 9px;\n          \"></div>\n\n          <div style=\"\n            position: absolute;\n            left: ${minimum}%;\n            top: 0;\n            width: 2px;\n            height: 100%;\n            background: #333;\n          \"></div>\n        </div>\n\n        <span style=\"\n          font-size: 13px;\n          font-weight: 600;\n          white-space: nowrap;\n        \">\n          ${value.toFixed(1)} %\n        </span>\n      </div>\n    `;\n  })()\n)) : \n  (() => {\n    const value = Math.min(100, Math.max(0, Number(currentRow.margin_percent) || 0));\n    const minimum = 30;\n\n    return `\n      <div style=\"\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        width: 100%;\n      \">\n        <div style=\"\n          position: relative;\n          width: 120px;\n          height: 18px;\n          background: #e5e7eb;\n          border-radius: 9px;\n          overflow: hidden;\n        \">\n          <div style=\"\n            width: ${value}%;\n            height: 100%;\n            background: #7a9b76;\n            border-radius: 9px;\n          \"></div>\n\n          <div style=\"\n            position: absolute;\n            left: ${minimum}%;\n            top: 0;\n            width: 2px;\n            height: 100%;\n            background: #333;\n          \"></div>\n        </div>\n\n        <span style=\"\n          font-size: 13px;\n          font-weight: 600;\n          white-space: nowrap;\n        \">\n          ${value.toFixed(1)} %\n        </span>\n      </div>\n    `;\n  })()\n })()}}",
